# =====================================================================
#  LF Viagens - Checagem de Voos
#  Copie este arquivo para ".env" e preencha os valores.
#  O arquivo .env fica SOMENTE na sua maquina e nao deve ser compartilhado.
# =====================================================================

# --- Login do MilhasFlow (o mesmo que voce usa no navegador) ---
MILHASFLOW_EMAIL=
MILHASFLOW_SENHA=

# --- Chave publica da API (nao e segredo: fica no proprio site) ---
# Como pegar:
#   1. Abra o MilhasFlow logado no Chrome
#   2. Menu > Mais ferramentas > Ferramentas do desenvolvedor (Cmd+Option+I)
#   3. Aba "Network" / "Rede"
#   4. Recarregue a pagina (Cmd+R)
#   5. Clique em qualquer linha que comece com "supabase.co"
#   6. Em "Headers" / "Cabecalhos", procure o campo "apikey"
#   7. Copie o valor inteiro (comeca com "eyJ...") e cole abaixo
MILHASFLOW_ANON_KEY=

# --- Identificadores (ja preenchidos, nao precisa mexer) ---
SUPABASE_URL=https://SEU_PROJETO_MILHASFLOW.supabase.co
ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

# --- Pasta onde o CSV diario e gravado ---
PASTA_DADOS=dados

# =====================================================================
#  ALERTAS
# =====================================================================
# Telegram - unico canal de alerta do sistema.
#   1. No Telegram, fale com @BotFather e mande /newbot
#   2. Ele devolve um token: cole em TELEGRAM_TOKEN
#   3. Mande qualquer mensagem para o seu bot
#   4. Rode:  python3 src/descobrir_chat.py   (mostra o TELEGRAM_CHAT_ID)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# =====================================================================
#  MALHA DAS COMPANHIAS  (opcional, mas e o que da cobertura de 100%)
# =====================================================================
# Consulta por numero de voo + data, sem localizador e sem sobrenome. E a
# unica fonte que alcanca TODOS os voos - inclusive TAP/Copa/AF/Qatar e as
# reservas GOL que o reCAPTCHA barra. Ver README, secao "Malha".
#
# Sem MALHA_API_KEY o resto do sistema segue funcionando normalmente; so
# essa fonte fica desligada.
#
# Fornecedor de referencia: AeroDataBox. Ele e vendido por canais
# diferentes, e cada canal tem BASE e cabecalho proprios. Confira na sua
# assinatura e ajuste as duas primeiras linhas:
#
#   API.market (padrao, e o canal do OpenAPI oficial)
#       MALHA_API_URL=https://prod.api.market/api/v1/aedbx/aerodatabox
#       MALHA_API_HEADER=x-api-market-key
#
#   RapidAPI
#       MALHA_API_URL=https://aerodatabox.p.rapidapi.com
#       MALHA_API_HEADER=x-rapidapi-key
#
MALHA_API_URL=https://prod.api.market/api/v1/aedbx/aerodatabox
MALHA_API_HEADER=x-api-market-key
MALHA_API_KEY=

# Horizonte em dias. Voo mais distante que isso raramente tem malha
# publicada e so gastaria cota - fica para o painel e para o e-mail.
MALHA_DIAS=120

# =====================================================================
#  PAINEL WEB (site)  (opcional)
# =====================================================================
# Projeto Supabase do site (separado do MilhasFlow) - e para onde a rodada
# das 7h espelha o resultado (voos/historico/observacoes), depois de
# checar. Vazio = sincronizacao desligada, resto do sistema roda igual.
#
# Local (supabase start, ver web/README.md): URL fixa, chave e impressa no
# terminal quando voce roda o comando.
# Hospedado: Project Settings > API > service_role key (secreta).
SUPABASE_WEB_URL=
SUPABASE_WEB_SERVICE_KEY=

# URL publica do painel (deploy no Vercel). Usada so para montar o link "ver
# no painel" que vai junto dos alertas do Telegram. Vazio = alerta sai sem
# esse link.
PAINEL_WEB_URL=https://lf-viagens-admin.vercel.app
