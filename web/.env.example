# Copie para .env.local (dev local contra `supabase start`) ou configure
# como env vars no Vercel (projeto hospedado).
#
# Em dev local, rode `supabase start` na raiz do repo e cole os valores que
# ele imprime (API_URL, ANON_KEY, SERVICE_ROLE_KEY).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nunca prefixar com NEXT_PUBLIC_ — só usado em Server Actions (gestão de
# usuários), nunca chega ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token do GitHub (fine-grained, permissão "Actions: Read
# and write" só no repo lf-viagens) - usado pelo botão "Checar agora" pra
# disparar a checagem de malha via workflow_dispatch (ver lib/github.ts).
# Sem isso o botão ainda funciona pra LATAM/GOL/Azul (fila pro Mac), só a
# malha que não dispara.
GITHUB_ACTIONS_TOKEN=

# Chave da API da OpenAI - usada só nas rotas server-side em
# app/api/extensao/* (extração de dados de passageiro por texto/foto e
# interpretação de busca de voo, chamadas pela extensão Chrome). Nunca
# prefixar com NEXT_PUBLIC_ — não pode chegar ao navegador nem à extensão.
OPENAI_API_KEY=

# --- Área de cedentes -------------------------------------------------

# Chave que cifra as credenciais das contas dos cedentes (AES-256-GCM, ver
# lib/cripto.ts). 32 bytes em base64:
#
#   openssl rand -base64 32
#
# Sem ela o cadastro guiado recusa a senha em vez de gravar em claro. Trocar
# a chave torna ilegível tudo que já foi gravado com a anterior — se algum
# dia precisar rotacionar, decifre e recifre antes de trocar.
CREDENCIAIS_CHAVE=

# Envio de cada conta de cedente aprovada pro MilhasFlow (tabela
# miles_accounts, uma linha por conta de programa — schema descoberto na
# prática em 20/08/2026, não documentado; ver lib/milhasflow.ts e
# scripts/descobrir_tabelas_milhasflow.py). Enquanto EMAIL/SENHA/ANON_KEY
# estiverem vazios, aprovar funciona normal e a conta fica marcada como não
# enviada, com botão de reenviar na ficha do cedente.
MILHASFLOW_URL=https://SEU_PROJETO_MILHASFLOW.supabase.co
MILHASFLOW_ANON_KEY=
MILHASFLOW_EMAIL=
MILHASFLOW_SENHA=
# organization_id fixo do MilhasFlow — só preencher se um dia ele mudar.
MILHASFLOW_ORGANIZATION_ID=
